# Copy to .env (git-ignored). Server-side only: nothing here is ever sent to the browser.

# The mock provider always works and needs no key. Real providers are OFF unless you opt in,
# so a public deployment cannot burn your credits by accident.
ALLOW_REAL_PROVIDERS=0

# Provider keys. Each provider appears in the picker only when its key is set (and real providers are on).
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint instead of api.openai.com: Azure OpenAI v1, Ollama (http://localhost:11434/v1),
# vLLM, LM Studio. A custom endpoint must list its models (comma separated).
OPENAI_BASE_URL=
OPENAI_COMPAT_MODELS=

# If set, real providers require this value in the "access token" field (x-playground-token header).
PLAYGROUND_ACCESS_TOKEN=

# Requests per minute per client for paid providers (default 30). One "run all 5 modes" is 10 requests.
PAID_RATE_LIMIT_PER_MIN=30

# Number of proxies in front of the server that append to X-Forwarded-For (1 behind a single NGINX).
# 0 (default) ignores the header, because a client can send any value in it.
TRUSTED_PROXY_HOPS=0
