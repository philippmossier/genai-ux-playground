{
  "name": "genai-ux-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Benchmark how an LLM answer reaches the user: one prompt, five delivery strategies, any model. Compare time to first content, total time, tokens and correctness.",
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && node --env-file-if-exists=.env ./node_modules/vite/bin/vite.js dev --port 3000",
    "build": "node scripts/copy-ort.mjs && vite build",
    "start": "node --env-file-if-exists=.env .output/server/index.mjs",
    "deploy:cloudflare": "node scripts/copy-ort.mjs && CLOUDFLARE=1 vite build && rm -f dist/server/.dev.vars && wrangler deploy -c dist/server/wrangler.json",
    "test": "vitest run",
    "check-types": "tsc --noEmit",
    "format": "prettier --write .",
    "lint": "eslint .",
    "check": "pnpm format && pnpm lint && pnpm check-types && pnpm test",
    "bench": "tsx scripts/bench.ts",
    "eval": "tsx scripts/eval.ts",
    "labels": "tsx scripts/print-labels.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@google/genai": "^2.27.0",
    "@huggingface/transformers": "^4.3.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.2",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.52.0",
    "openai": "^7.27.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.5",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@11.15.0"
}
